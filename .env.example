# Required in production: generate your own random secret (same value on API + Worker).
XYDL_SIGNING_KEY=
# URL of your deployed Cloudflare Worker; unrelated vendor keys are not required.
XYDL_PROXY_BASE=https://your-worker.example.com
# Optional extraction proxy for cloud-blocked platforms. Keep off unless configured.
XYDL_EXTRACT_PROXY=
XYDL_PROXY_POOL=off
XYDL_PROXY_TRIES=3
XYDL_RATE_LIMIT=25
XYDL_STREAM_RATE_LIMIT=120
# Extra frontend origins, comma separated (production allowlist).
XYDL_EXTRA_ORIGINS=
